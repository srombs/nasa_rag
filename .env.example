# Container runtime settings. The application does not automatically load this
# file. Docker can read a populated local copy with --env-file .env.
# Fill in the key in the local copy or supply it through Railway's Variables UI.
OPENAI_API_KEY=

PORT=8000
# Persist these paths by mounting a writable volume at /data.
NASA_RAG_CACHE_DIR=/data/cache
NASA_RAG_COST_LOG_PATH=/data/logs/model_costs.jsonl
NASA_RAG_RESPONSE_TIMEOUT_SECONDS=120
# Keep empty until the actual server proxy's IPs/CIDRs are known.
NASA_RAG_TRUSTED_PROXIES=
